{
  "name": "openjobs-public",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/cli",
    "packages/sdk-js",
    "packages/langchain-js"
  ],
  "scripts": {
    "check": "npm --workspace @openjobs/sdk run build && npm --workspace @openjobs/cli run build && npm --workspaces --if-present run typecheck && npm run lint:ts && python -m compileall -q packages/sdk-python packages/openjobs-langchain packages/openjobs-crewai packages/openjobs-openai && npm run check:examples",
    "lint:ts": "biome check packages/sdk-js/src packages/cli/src packages/langchain-js/src",
    "check:python-packages": "node scripts/check-python-packages.mjs",
    "check:sdk-js-tests": "node scripts/check-sdk-js-tests.mjs",
    "check:npm-pack": "node scripts/check-npm-pack.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:cli-smoke": "node scripts/check-cli-smoke.mjs",
    "check:examples": "node scripts/check-examples.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}
